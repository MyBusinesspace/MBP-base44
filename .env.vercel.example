# =============================================================================
# Vercel — انسخ إلى .env.vercel ثم:
# Vercel → Settings → Environment Variables → Import .env → اختر .env.vercel
# Production + Preview → Redeploy + git push (server code)
# =============================================================================

VITE_APP_ID=mpb-local
VITE_GOOGLE_OAUTH_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-1-ap-south-1.pooler.supabase.com:6543/postgres
DATABASE_POOLER_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-1-ap-south-1.pooler.supabase.com:6543/postgres
SUPABASE_DB=true
SUPABASE_REGION=ap-south-1
SUPABASE_POOLER_PREFIX=aws-1
SKIP_SCHEMA_ON_BOOT=true

JWT_SECRET=long-random-string-at-least-32-chars
AUTH_REQUIRED=true
WEB_URL=https://your-app.vercel.app

GOOGLE_OAUTH_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your-google-client-secret
GOOGLE_OAUTH_CALLBACK_URL=https://your-app.vercel.app/api/auth/google/callback

GOOGLE_PLACES_API_KEY=
DAILY_API_KEY=
ZAPIER_WEBHOOK_URL=
