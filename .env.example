# =============================================================================
# LOCAL (.env) — انسخ إلى .env وعدّل القيم
# VERCEL (.env.vercel) — انسخ إلى .env.vercel واستورد في Vercel Dashboard
# =============================================================================

# --- Local only ---
VITE_APP_ID=mpb-local
VITE_GOOGLE_OAUTH_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

DATABASE_URL=postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres
SUPABASE_DB=true
SUPABASE_REGION=ap-south-1
SUPABASE_POOLER_PREFIX=aws-1

API_PORT=3001
WEB_URL=http://localhost:5173
GOOGLE_OAUTH_CALLBACK_URL=http://localhost:3001/api/auth/google/callback

# --- See .env.vercel.example for Vercel (pooler 6543, not db.xxx) ---

GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
JWT_SECRET=generate-a-long-random-string
AUTH_REQUIRED=true
LOCAL_ADMIN_PASSWORD=admin123

GOOGLE_PLACES_API_KEY=
DAILY_API_KEY=
ZAPIER_WEBHOOK_URL=

# --- Email (user invitations) ---
# Test without domain (copy link from UI, no real email):
# EMAIL_DRY_RUN=true
# Or use Resend OR SMTP:
# Resend (recommended on Vercel): https://resend.com — verify your domain, then:
# RESEND_API_KEY=re_xxxxxxxx
# EMAIL_FROM=MyBusinessPace <invites@yourdomain.com>
# Or SMTP (Gmail app password, SendGrid, etc.):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your@gmail.com
# SMTP_PASS=app-password
# EMAIL_FROM=your@gmail.com
