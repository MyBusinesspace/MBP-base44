# ========== Local development (default) ==========
VITE_APP_ID=mpb-local
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mpb_crm
DATABASE_URL=postgresql://postgres:cqbXmy5MoshCQLDY@db.aevwxwintewlcgxwvkrc.supabase.co:5432/postgres
SUPABASE_DB=true

API_PORT=3001
WEB_URL=http://localhost:5173
AUTH_REQUIRED=true
LOCAL_ADMIN_PASSWORD=admin123
JWT_SECRET=change-this-to-a-long-random-string

# Optional API keys
GOOGLE_PLACES_API_KEY=
DAILY_API_KEY=
ZAPIER_WEBHOOK_URL=

# Google OAuth (local callback)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_CALLBACK_URL=http://localhost:3001/api/auth/google/callback

# ========== Supabase (copy to Vercel Environment Variables) ==========
# Project Settings → Database → Connection string → URI (Transaction pooler, port 6543)
# --- Supabase (project ref example: aevwxwintewlcgxwvkrc) ---
# Local (direct, port 5432):
# DATABASE_URL=postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres
# Vercel (pooler, port 6543) — recommended for production:
# DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true
# SUPABASE_PROJECT_REF=aevwxwintewlcgxwvkrc
# SUPABASE_REGION=eu-central-1
# SUPABASE_DB=true
# SKIP_SCHEMA_ON_BOOT=true

# ========== Vercel production (add in Vercel Dashboard, NOT .env upload) ==========
# Server secrets: NO "VITE_" prefix for secrets. For Google button on login page ALSO set:
# VITE_GOOGLE_OAUTH_CLIENT_ID=<same as GOOGLE_OAUTH_CLIENT_ID>  (required at BUILD time)
# WEB_URL=https://your-app.vercel.app
# GOOGLE_OAUTH_CLIENT_ID=...
# GOOGLE_OAUTH_CLIENT_SECRET=...
# GOOGLE_OAUTH_CALLBACK_URL=https://your-app.vercel.app/api/auth/google/callback
# After adding vars: Redeploy required
# Check: https://your-app.vercel.app/api/config/status
